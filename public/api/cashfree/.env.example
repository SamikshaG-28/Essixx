# Cashfree PG CSV: col1 = CASHFREE_CLIENT_ID, col2 = CASHFREE_CLIENT_SECRET
CASHFREE_ENV=production
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
PAYMENT_RETURN_URL=https://essixx.com/payment/return

# Firestore (free service account JSON — not a Firebase plan upgrade)
FIREBASE_PROJECT_ID=essy-bbd67
# Path to the essy-bbd67 service account JSON, relative to
# public/api/cashfree/ (or absolute). Without it every Firestore
# read returns HTTP 500 and app sign-in cannot complete.
FIREBASE_SERVICE_ACCOUNT_PATH=service-account.json
