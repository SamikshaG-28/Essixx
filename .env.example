# Public site URL used for canonical links, Open Graph, sitemap, and JSON-LD.
VITE_SITE_URL=https://www.essixx.com

# Payment API runs on Hostinger via PHP (same origin, no Firebase Functions).
# Configure: public/api/cashfree/.env and service-account.json — see docs/HOSTINGER_PAYMENT.md

# Firebase web config (essy-bbd67). Identifiers, not secrets — access is
# controlled by Firestore rules and the enabled Auth providers. Omit any of
# these and the values baked into src/lib/firebase.js are used instead.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
